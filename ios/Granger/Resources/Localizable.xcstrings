    "%@ will be deleted from this phone and taken off this list; Show removed brings it back. Your place, bookmarks and highlights are kept." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará %@ de este teléfono y saldrá de esta lista; Mostrar los quitados lo trae de vuelta. Se conservan tu lugar, tus marcadores y tus resaltados."
          }
        }
      }
    },
    "%@ will be deleted from this phone, with its books. You can download it again later. Your places, bookmarks and highlights are kept." : {
