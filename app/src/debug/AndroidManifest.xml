<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets the voice spike list and bind the phone's text-to-speech engines (package visibility, API 30+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Lets the voice input spike list the phone's speech recognizers (Plan A0). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <!-- Plan A0 only: the main manifest gets RECORD_AUDIO in A1, if voice input is adopted. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- A catalog served from the Mac over `adb reverse` (-PcatalogUrl). -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name="app.granger.spike.SpikeActivity"
            android:exported="true"
            android:label="Granger Spike">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="app.granger.research.ResearchBenchmarkActivity"
            android:exported="true"
            android:label="Research benchmark" />
        <activity
            android:name="app.granger.voice.VoiceSpikeActivity"
            android:exported="true"
            android:label="Voice spike" />
        <activity
            android:name="app.granger.ebook.PdfBenchActivity"
            android:exported="true"
            android:label="PDF bench" />
        <activity
            android:name="app.granger.voiceinput.VoiceInputSpikeActivity"
            android:exported="true"
            android:label="Voice input spike" />
        <activity
            android:name="app.granger.eval.EvalActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="Granger eval" />
    </application>
</manifest>
