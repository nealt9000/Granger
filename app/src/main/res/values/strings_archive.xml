<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The archive.org screen's title: the site's name. -->
    <string name="archive_title">Archive.org</string>
    <string name="archive_disclaimer">Archive.org content is provided by the Internet Archive. Granger doesn\'t host or vouch for it.</string>
    <string name="archive_unfiltered_note">Showing everything archive.org serves openly. You\'re responsible for what you download.</string>
    <string name="archive_spoken_word_note">Archive.org dates spoken-word recordings by their text, not the recording, so Granger can\'t tell which are in the public domain. LibriVox recordings all are.</string>
    <string name="archive_texts_note">Showing public-domain texts only: published 1930 or earlier.</string>
    <!-- %1$d is the first year left out, such as 1926. -->
    <string name="archive_recordings_note">Showing public-domain recordings only: published before %1$d.</string>
    <!-- The search box's placeholder in each archive.org view. -->
    <string name="archive_search_texts">Search archive.org texts</string>
    <string name="archive_search_audiobooks">Search archive.org audiobooks</string>
    <string name="archive_search_music">Search archive.org music</string>
    <!-- Tabs: archive.org's results, and what's been downloaded from it. -->
    <string name="archive_tab_browse">Browse</string>
    <string name="archive_tab_installed">Installed</string>
    <!-- The button to LibriVox, the free audiobook site; its name. -->
    <string name="archive_librivox">LibriVox</string>
    <!-- Opens the waiver to turn off the public-domain filter. -->
    <string name="archive_show_everything">Show everything</string>
    <string name="archive_empty_installed">Nothing downloaded from archive.org yet.</string>
    <string name="archive_empty_search">Nothing matches that search.</string>
    <string name="archive_load_more">Load more</string>
    <!-- %1$s is the item's title. -->
    <string name="archive_remove_title">Remove %1$s?</string>
    <string name="archive_remove_text_body">This deletes the file. Your place and highlights are kept.</string>
    <string name="archive_remove_audio_body">This deletes its files. Your place and bookmarks are kept.</string>
    <!-- Asks before a big download; %1$s is its size, such as 212 MB. -->
    <string name="archive_large_pdf">This PDF is %1$s. Download it?</string>
    <string name="archive_large_download">This download is %1$s. Download it?</string>
    <string name="archive_dont_ask_again">Don\'t ask again</string>
    <string name="archive_download">Download</string>
    <!-- Gets what's left of a partly downloaded item. -->
    <string name="archive_get_the_rest">Get the rest</string>

    <!-- What an item offers. -->
    <string name="archive_offer_plain_text">Plain text</string>
    <!-- Text read from a scan by a machine (optical character recognition). -->
    <string name="archive_offer_ocr">OCR text: may have errors</string>
    <string name="archive_offer_ocr_pdf">OCR text: may have errors · PDF</string>
    <!-- The item can only be borrowed, on archive.org's own site. -->
    <string name="archive_borrow">Borrow on archive.org</string>
    <string name="archive_no_text">No downloadable text</string>
    <string name="archive_no_audio">No downloadable audio</string>
