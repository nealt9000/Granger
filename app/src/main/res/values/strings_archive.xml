    <plurals name="archive_tracks">
        <item quantity="one">%1$d track · %2$s</item>
        <item quantity="other">%1$d tracks · %2$s</item>
    </plurals>

    <!-- The item sheet. %1$d of %2$d files are in. -->
    <string name="archive_downloading_files">Downloading: %1$d of %2$d</string>
    <!-- %1$s is the PDF's size. -->
    <string name="archive_get_pdf">Get PDF · %1$s</string>
    <string name="archive_pdf_in_library">PDF in your library</string>
    <!-- Where the PDF's own download stands. -->
    <string name="archive_pdf_queued">PDF: queued</string>
    <!-- %1$d is the percent done. -->
    <string name="archive_pdf_downloading">PDF: downloading, %1$d%%</string>
    <string name="archive_pdf_failed">PDF: failed</string>
    <!-- The PDF line's lead when it has no other status; the trailing space is kept. -->
    <string name="archive_pdf_other">"PDF: "</string>
    <string name="archive_view_on_site">View on archive.org</string>
    <!-- Get, with the download's size. -->
    <string name="archive_get_size">Get · %1$s</string>

    <!-- The waiver that turns off the public-domain filter. -->
    <string name="archive_waiver_title">Show everything on archive.org?</string>
    <string name="archive_waiver_body">Granger is a browser for archive.org. It doesn\'t host, check or vouch for anything there, and much of it is still under copyright. You\'re responsible for having the right to download and use what you take.</string>
    <string name="archive_waiver_accept">I accept</string>

    <!-- Notices after Get. -->
    <string name="archive_no_storage">No storage is available right now.</string>
    <!-- %1$s is the storage, such as Internal storage; %2$s the item; %3$s the space needed. -->
    <string name="archive_no_space">Not enough space on %1$s for %2$s: free up %3$s.</string>
    <!-- %1$s is the item; %2$s the total it would make; %3$s the downloads limit. -->
    <string name="archive_over_cap">%1$s would bring your downloads to %2$s, over the %3$s limit.</string>
