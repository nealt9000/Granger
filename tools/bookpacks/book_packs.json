{
  "about": "Plan KB2: the Kiwix packs shown as book collections through a .gbooks manifest, and how build.py reads each (extractor, filters, groups, title overrides). Gutenberg and nautilus packs carry their own lists and aren't here.",
  "packs": {
    "africanstorybook.org_mul_all": {
      "extractor": "kolibri",
      "title": "African Storybook",
      "noun": "books",
      "provider": "African Storybook Initiative",
      "licence": "CC BY",
      "shelf": "children"
    },
    "irp.fas.org_en_military-medicine": {
      "extractor": "zimit-index",
      "title": "Military Medicine",
      "noun": "books",
      "provider": "Federation of American Scientists",
      "shelf": "manuals"
    },
    "smbc-comics.com_en_all": {
      "extractor": "zimit-index",
      "title": "SMBC COVID-19 Book Pack",
      "noun": "books",
      "provider": "Saturday Morning Breakfast Cereal",
      "shelf": "literature",
      "overrides": {
        "www.smbc-comics.com/covid/files/augie_german.pdf": "Augie and the Green Knight (German)"
      }
    },
    "jeffe.cs.illinois.edu_en_all": {
      "extractor": "zimit-index",
      "title": "Algorithms",
      "noun": "documents",
      "provider": "Jeff Erickson",
      "licence": "CC BY 4.0",
      "shelf": "learning",
      "groups": [
        {
          "key": "book",
          "title": "The book",
          "match": "/teaching/algorithms/(book|notes|models)/"
        },
        {
          "key": "course",
          "title": "Course materials",
          "match": "/teaching/algorithms/"
        }
      ],
      "pathTitles": [
        {
          "match": "hwex/(?P<t>[fs])(?P<yy>\\d\\d)-hwex\\.pdf$",
          "title": "{t} {yy} · Homework and exams",
          "maps": {
            "t": {
              "f": "Fall",
              "s": "Spring"
            }
          }
        },
        {
          "match": "hwex/(?P<t>[fs])(?P<yy>\\d\\d)-everything\\.pdf$",
          "title": "{t} {yy} · Everything",
          "maps": {
            "t": {
              "f": "Fall",
              "s": "Spring"
            }
          }
        },
        {
          "match": "hwex/(?P<t>[fs])(?P<yy>\\d\\d)/(?:[a-z]+/)?(?:[fs]\\d\\d-)?(?P<kind>all-hw|all-exams|all-labs|allhw|allex|labs|hw|lab|hbs|bang|midterm|mt|final|exam|quiz|conflict)(?P<n>[^/]*)\\.pdf$",
          "title": "{t} {yy} · {kind} {n}",
          "maps": {
            "t": {
              "f": "Fall",
              "s": "Spring"
            },
            "kind": {
              "hw": "Homework",
              "lab": "Lab",
              "hbs": "Head-banging session",
              "bang": "Head-banging session",
              "mt": "Midterm",
              "midterm": "Midterm",
              "final": "Final exam",
              "exam": "Exam",
              "quiz": "Quiz",
              "conflict": "Conflict exam",
              "all-hw": "All homework",
              "allhw": "All homework",
              "all-exams": "All exams",
              "allex": "All exams",
              "all-labs": "All labs",
              "labs": "All labs"
            }
          }
        },
        {
          "match": "algorithms/(book|models|notes)/(?P<n>[0-9A-Z!]+)-(?P<name>[^/]+)\\.pdf$",
          "title": "{name}",
          "fallback": true,
          "capitalize": true
        }
      ],
      "overrides": {
        "jeffe.cs.illinois.edu/teaching/algorithms/hwex/old-hwex.pdf": "Homework and exams · 2003 revision",
        "jeffe.cs.illinois.edu/teaching/algorithms/hwex/ancient-hwex.pdf": "Homework and exams · before 2003"
      }
    },
    "milneopentextbooks.org_en_all": {
      "extractor": "zimit-index",
      "title": "Milne Open Textbooks",
      "noun": "books",
      "provider": "SUNY Geneseo Milne Library",
      "shelf": "learning",
      "minBytes": 200000,
      "site": "Milne Open Textbooks"
    },
    "survivorlibrary.com_en_all": {
      "extractor": "zimit-index",
      "title": "Survivor Library",
      "noun": "books",
      "provider": "Survivor Library",
      "shelf": "manuals",
      "groupBy": "page",
      "groupPattern": "^Library-(?P<g>.+)$",
      "yearSuffix": true
    }
  }
}
